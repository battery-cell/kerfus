<?xml version="1.0"?>
<!--
  Test room for mapping and navigation: 6 m x 5 m, centred on the origin, with three obstacles.
  The robot spawns at (0, 0) facing +X. Edit the wall and obstacle poses to match a real room.
  World name "kerfus_room" is used by launch/sim.launch.py: keep them in sync.
-->
<sdf version="1.8">
  <world name="kerfus_room">

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Needed for the simulated lidar. If the GUI fails to start on your graphics card,
         change ogre2 to ogre. -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Walls: 6 m (x) by 5 m (y), 1 m high, 0.1 m thick -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.55 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.2 0.1 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.55 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.2 0.1 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.2 0.1 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3.05 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 5.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 5.0 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3.05 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 5.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.1 5.0 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacles. The lidar scans at about 0.127 m, so they must be taller than that. -->
    <model name="crate">
      <static>true</static>
      <pose>1.5 1.0 0.35 0 0 0.3</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.7</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.7 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar">
      <static>true</static>
      <pose>-1.5 -1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.5 0.7 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <static>true</static>
      <pose>-1.0 1.7 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.5 0.7</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.5 0.7</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
